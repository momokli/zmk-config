 * SPDX-License-Identifier: MIT
 *
 * Aurora Lily58 (58 Tasten) — QWERTZ Deutsch
 * Einsteiger-freundliches Split-Layout
 *
 * Layer:
 *   0: Base (QWERTZ-Deutsch)
 *   1: NAV (Navigation, Media, F-Tasten)
 *   2: SYM (Symbole, Zahlen, Funktionen)
 */

#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ─── Layer 0: Base (QWERTZ Deutsch) ─────────────────────────────────── */
        /*                                                                         */
        /* Links:                                    Rechts:                      */
        /* ┌─────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┬─────┐
         * │  1  │  2  │  3  │  4  │  5  │  6  │   │  7  │  8  │  9  │  0  │  ß  │  ´  │
         * ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
         * │  Q  │  W  │  E  │  R  │  T  │  Z  │   │  U  │  I  │  O  │  P  │  Ü  │  +  │
         * ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
         * │  A  │  S  │  D  │  F  │  G  │  H  │   │  J  │  K  │  L  │  Ö  │  Ä  │  #  │
         * ├─────┼─────┼─────┼─────┼─────┼─────┼──┐ ┌──┼─────┼─────┼─────┼─────┼─────┼─────┤
         * │  Y  │  X  │  C  │  V  │  B  │  N  │M │ │, │  .  │  -  │ ENT │ TAB │ BSP │ DEL │
         * └─────┴─────┴─────┴─────┴─────┴─────┴──┘ └──┴─────┴─────┴─────┴─────┴─────┴─────┘
         *           ┌─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┐
         *           │CTRL │ ALT │ SPC │ NA  │       │ SYM │ ALT │ SPC │ ENT │
         *           └─────┴─────┴─────┴─────┘       └─────┴─────┴─────┴─────┘
         *                                                                         */

        base {
            bindings = <
    // ── LEFT TOP (0-5) ──              ── RIGHT TOP (29-34) ──
    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp DE_ESZETT   &kp DE_ACUTE
    // ── LEFT HOME (6-11) ──            ── RIGHT HOME (35-40) ──
    &kp Q   &kp W   &kp E   &kp R   &kp T   &kp Z   &kp U   &kp I   &kp O   &kp P   &kp DE_U_UMLAUT &kp DE_PLUS
    // ── LEFT BOTTOM (12-17) ──         ── RIGHT BOTTOM (41-46) ──
    &kp A   &kp S   &kp D   &kp F   &kp G   &kp H   &kp J   &kp K   &kp L   &kp DE_O_UMLAUT &kp DE_A_UMLAUT &kp DE_HASH
    // ── LEFT INNER (18-24) ──          ── RIGHT INNER (47-53) ──
    &kp Y   &kp X   &kp C   &kp V   &kp B   &kp N   &kp M   &kp DE_COMMA &kp DE_DOT &kp MINUS &kp RETURN &kp TAB &kp BACKSPACE &kp DELETE
    // ── LEFT THUMB (25-28) ──          ── RIGHT THUMB (54-57) ──
            &kp LCTRL &kp LALT &kp SPACE &lt 1 TAB  &lt 2 ENTER &kp LALT &kp SPACE &kp RETURN
            >;
        };

        /* ─── Layer 1: NAV (Navigation) ───────────────────────────────────────── */
        /* SPACE halten (links) aktiviert diesen Layer                          */
        /*                                                                         */
        /* Links:                                    Rechts:                      */
        /* ┌─────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┬─────┐
         * │ F1  │ F2  │ F3  │ F4  │ F5  │ F6  │   │ F7  │ F8  │ F9  │ F10 │ F11 │ F12 │
         * ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │     │   │     │     │     │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │     │   │     │     │     │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┼─────┼──┐ ┌──┼─────┼─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │     │   │ │   │     │     │     │     │     │     │
         * └─────┴─────┴─────┴─────┴─────┴─────┴──┘ └──┴─────┴─────┴─────┴─────┴─────┴─────┘
         *           ┌─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┐
         *           │     │     │     │ TRNS│       │ TRNS│     │     │     │
         *           └─────┴─────┴─────┴─────┘       └─────┴─────┴─────┴─────┘
         *                                                                         */

        NAV {
            bindings = <
    &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11       &kp F12
    &none    &none    &none    &none    &none    &none    &none    &kp UP    &none    &none    &none         &none
    &none    &none    &none    &none    &none    &none    &kp LEFT &kp DOWN  &kp RIGHT  &none   &none         &none
    &none    &none    &none    &none    &none    &none    &none    &none     &none     &none    &none         &none
            &none    &none    &none    &none    &none    &none    &none    &none
            >;
        };

        /* ─── Layer 2: SYM (Symbole & Zahlen) ─────────────────────────────────── */
        /* ENTER halten (rechts) aktiviert diesen Layer                         */
        /*                                                                         */
        /* Links:                                    Rechts:                      */
        /* ┌─────┬─────┬─────┬─────┬─────┬─────┐   ┌─────┬─────┬─────┬─────┬─────┬─────┐
         * │  !  │  "  │  §  │  $  │  %  │  &  │   │  /  │  (  │  )  │  =  │  ?  │  `  │
         * ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
         * │     │  @  │  ~  │  |  │  \  │     │   │  [  │  ]  │  {  │  }  │     │     │
         * ├─────┼─────┼─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │     │   │     │     │  _  │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┼─────┼──┐ ┌──┼─────┼─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │     │   │ │   │     │     │     │     │     │     │
         * └─────┴─────┴─────┴─────┴─────┴─────┴──┘ └──┴─────┴─────┴─────┴─────┴─────┴─────┘
         *           ┌─────┬─────┬─────┬─────┐       ┌─────┬─────┬─────┬─────┐
         *           │     │     │     │     │       │ TRNS│     │     │     │
         *           └─────┴─────┴─────┴─────┘       └─────┴─────┴─────┴─────┘
         *                                                                         */

        SYM {
            bindings = <
    &kp DE_EXCLAMATION &kp DE_DOUBLE_QUOTES &kp DE_SECTION  &kp DE_DOLLAR  &kp DE_PERCENT  &kp DE_AMPERSAND &kp DE_SLASH &kp DE_LEFT_PAREN  &kp DE_RIGHT_PAREN &kp DE_EQUAL &kp DE_QUESTION &kp DE_GRAVE
    &none    &kp DE_AT_SIGN &kp DE_TILDE &kp DE_PIPE  &kp DE_BACKSLASH  &none    &kp DE_LEFT_BRACKET &kp DE_RIGHT_BRACKET &kp DE_LEFT_CURLY_BRACE &kp DE_RIGHT_CURLY_BRACE &none &none
    &none    &none    &none    &none    &none    &none    &none    &none    &kp UNDERSCORE &none       &none       &none
    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none    &none
            &none    &none    &none    &none    &none    &none    &none    &none
            >;
        };
    };
};
