 *
 * Aurora Lily58 (58 Tasten) — QWERTZ Deutsch
 * Links-hand-zentrisch (linke Hälfte funktioniert allein)
 *
 * Use Cases:
 *   - Tägliches Tippen (QWERTZ)
 *   - Gaming (WASD-Layer per Toggle)
 *   - CAD/Macros (technisches Zeichnen)
 *
 * Layer:
 *   0: Base   — QWERTZ Deutsch
 *   1: NA     — Navigation, F-Tasten, Media
 *   2: CAD    — CAD-Shortcuts (Strg+Z/C/V/X, etc.)
 *   3: Gaming — WASD + Gaming-Keys (Toggle per Combo)
 */

#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        GamingToggle {
            bindings = <&tog 3>;
            key-positions = <0 12>;
            timeout-ms = <50>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ═══════════════════════════════════════════════════════════════════════════
           LAYER 0: BASE (QWERTZ Deutsch)
           ═══════════════════════════════════════════════════════════════════════════
           Links (allein nutzbar):                     Rechts (optional):
           ┌─────┬─────┬─────┬─────┬─────┬─────┐      ┌─────┬─────┬─────┬─────┬─────┬─────┐
           │  1  │  2  │  3  │  4  │  5  │  6  │      │  7  │  8  │  9  │  0  │  ß  │  ´  │
           ├─────┼─────┼─────┼─────┼─────┼─────┤      ├─────┼─────┼─────┼─────┼─────┼─────┤
           │  Q  │  W  │  E  │  R  │  T  │  Z  │      │  U  │  I  │  O  │  P  │  Ü  │  +  │
           ├─────┼─────┼─────┼─────┼─────┼─────┤      ├─────┼─────┼─────┼─────┼─────┼─────┤
           │  A  │  S  │  D  │  F  │  G  │  H  │      │  J  │  K  │  L  │  Ö  │  Ä  │  #  │
           ├─────┼─────┼─────┼─────┼─────┼─────┼──┐   ┌──┼─────┼─────┼─────┼─────┼─────┼─────┤
           │  Y  │  X  │  C  │  V  │  B  │  N  │M │   │, │  .  │  -  │ ENT │ TAB │ BSP │ DEL │
           └─────┴─────┴─────┴─────┴─────┴─────┴──┘   └──┴─────┴─────┴─────┴─────┴─────┴─────┘
                    ┌─────┬─────┬─────┬─────┐          ┌─────┬─────┬─────┬─────┐
                    │CTRL │ SPC │ ALT │ NA  │          │ SYM │ SPD │ ALT │ ENT │
                    └─────┴─────┴─────┴─────┘          └─────┴─────┴─────┴─────┘
           ═══════════════════════════════════════════════════════════════════════════ */

        base {
            bindings = <
    // ── TOP (0-5) ──                   ── TOP (29-34) ──
    &kp N1      &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp DE_ESZETT   &kp DE_ACUTE
    // ── HOME (6-11) ──                 ── HOME (35-40) ──
    &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Z       &kp U       &kp I       &kp O       &kp P       &kp DE_U_UMLAUT &kp DE_PLUS
    // ── BOTTOM (12-17) ──              ── BOTTOM (41-46) ──
    &kp A       &kp S       &kp D       &kp F       &kp G       &kp H       &kp J       &kp K       &kp L       &kp DE_O_UMLAUT &kp DE_A_UMLAUT &kp DE_HASH
    // ── INNER (18-24) ──               ── INNER (47-53) ──
    &kp Y       &kp X       &kp C       &kp V       &kp B       &kp N       &kp M       &kp DE_COMMA &kp DE_DOT  &kp MINUS    &kp RETURN    &kp TAB      &kp BACKSPACE &kp DELETE
    // ── THUMB (25-28) ──               ── THUMB (54-57) ──
                &kp LCTRL  &kp SPACE   &kp LALT    &lt 1 TAB   &lt 2 ENTER &kp LALT    &kp SPACE   &kp RETURN
            >;
        };

        /* ═══════════════════════════════════════════════════════════════════════════
           LAYER 1: NA (Navigation / F-keys)
           ═══════════════════════════════════════════════════════════════════════════
           Daumen-Taste (pos 28) halten → Layer 1
           ═══════════════════════════════════════════════════════════════════════════ */

        NA {
            bindings = <
    &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11         &kp F12
    &none       &none       &none       &none       &none       &none       &none       &kp UP      &none       &none       &none           &none
    &none       &none       &none       &none       &none       &none       &kp LEFT    &kp DOWN    &kp RIGHT   &none       &none           &none
    &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &none           &none
                &none       &none       &none       &none       &none       &none       &none       &none
            >;
        };

        /* ═══════════════════════════════════════════════════════════════════════════
           LAYER 2: CAD (Technisches Zeichnen / Macros)
           ═══════════════════════════════════════════════════════════════════════════
           Shortcuts für AutoCAD / Fusion 360 / etc.
           ═══════════════════════════════════════════════════════════════════════════ */

        CAD {
            bindings = <
    // ── TOP ──                         ── TOP ──
    &kp GRAVE   &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10         &kp F11
    // ── HOME ──                        ── HOME ──
    &none       &kp LC(S)   &kp LC(P)   &kp LC(Z)   &kp LC(Y)   &none       &none       &none       &none       &none       &kp F12         &none
    // ── BOTTOM ──                      ── BOTTOM ──
    &kp LC(X)   &kp LC(C)   &kp LC(V)   &none       &none       &none       &none       &none       &none       &none       &none           &none
    // ── INNER ──                       ── INNER ──
    &none       &none       &none       &none       &none       &none       &none       &none       &none       &none       &none           &none
    // ── THUMB ──                       ── THUMB ──
                &none       &none       &none       &none       &none       &none       &none       &none
            >;
        };

        /* ═══════════════════════════════════════════════════════════════════════════
           LAYER 3: GAMING (WASD + Gaming Keys)
           ═══════════════════════════════════════════════════════════════════════════
           Toggle per Combo (pos 0 + 12) oder per NA-Layer (F12 o.ä.)
           ┌─────┬─────┬─────┬─────┬─────┬─────┐      ┌─────┬─────┬─────┬─────┬─────┬─────┐
           │ GRAV│  1  │  W  │  2  │  3  │  4  │      │  5  │  6  │  7  │  8  │  9  │  0  │
           ├─────┼─────┼─────┼─────┼─────┼─────┤      ├─────┼─────┼─────┼─────┼─────┼─────┤
           │  Q  │  A  │  S  │  D  │  E  │  R  │      │  T  │  Z  │  U  │  I  │  O  │  P  │
           ├─────┼─────┼─────┼─────┼─────┼─────┤      ├─────┼─────┼─────┼─────┼─────┼─────┤
           │ LSH │  F  │  C  │  X  │  V  │  B  │      │  N  │  M  │  ,  │  .  │  -  │     │
           ├─────┼─────┼─────┼─────┼─────┼─────┼──┐   ┌──┼─────┼─────┼─────┼─────┼─────┼─────┤
           │ TAB │  ~  │  G  │  H  │  J  │  K  │L │   │   │     │     │     │     │     │     │
           └─────┴─────┴─────┴─────┴─────┴─────┴──┘   └──┴─────┴─────┴─────┴─────┴─────┴─────┘
                    ┌─────┬─────┬─────┬─────┐          ┌─────┬─────┬─────┬─────┐
                    │CTRL │ SPC │ ALT │TRNS │          │TRNS │     │     │     │
                    └─────┴─────┴─────┴─────┘          └─────┴─────┴─────┴─────┘
           ═══════════════════════════════════════════════════════════════════════════ */

        Gaming {
            bindings = <
    &tog 3      &kp N1      &kp W       &kp N2      &kp N3      &kp N4      &kp N5      &kp N6      &kp N7      &kp N8      &kp N9          &kp N0
    &kp Q       &kp A       &kp S       &kp D       &kp E       &kp R       &kp T       &kp Z       &kp U       &kp I       &kp O           &kp P
    &kp LSHIFT  &kp F       &kp C       &kp X       &kp V       &kp B       &kp N       &kp M       &kp DE_COMMA &kp DE_DOT &kp MINUS      &none
    &kp TAB     &kp GRAVE   &kp G       &kp H       &kp J       &kp K       &kp L       &none       &none       &none       &none           &none
                &kp LCTRL  &kp SPACE   &kp LALT    &none       &none       &none       &none       &none
            >;
        };
    };
};
